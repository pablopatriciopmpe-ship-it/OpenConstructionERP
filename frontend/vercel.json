{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Skipping npm install for prebuilt v19.9.0 dist'",
  "buildCommand": "node scripts/build-dist.mjs",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/api/(.*)$", "dest": "https://openconstructionerp.com/api/$1" },
    { "handle": "filesystem" },
    { "src": "^/(?!api/|assets/|cesium/|pwa/|brand/|favicon|manifest|sw\\.js|workbox-)(.*)$", "dest": "/index.html" }
  ]
}
