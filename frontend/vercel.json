{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund --legacy-peer-deps",
  "buildCommand": "node --max-old-space-size=5632 ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/api/(.*)$", "dest": "https://erp-teste.evolux-erp.workers.dev/api/$1" },
    { "handle": "filesystem" },
    { "src": "^/(?!api/|assets/|cesium/|pwa/|brand/|favicon|manifest|sw\\.js|workbox-)(.*)$", "dest": "/index.html" }
  ]
}
