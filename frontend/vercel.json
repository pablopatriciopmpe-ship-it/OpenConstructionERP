{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Skipping npm install for prebuilt v19.9.0 dist'",
  "buildCommand": "node scripts/build-dist.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://openconstructionerp.com/api/:path*" },
    { "source": "/((?!api/|assets/|cesium/|pwa/|brand/|favicon|manifest|sw\\.js|workbox-).*)", "destination": "/index.html" }
  ]
}
